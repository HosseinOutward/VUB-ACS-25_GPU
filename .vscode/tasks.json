{
    "version": "2.0.0",
    "options": {
        "env": {
            "CUDA_PATH": "D:/User/Software/Nvidia/CUDA/1211"
        }
    },
    "tasks": [
        {
            "label": "build-active-file",
            "type": "shell",
            "command": "clang++",
            "args": [
                "--target=x86_64-w64-windows-gnu",
                "-std=c++17",
                "-g",
                "-O3",
                "-Wall",
                "-Wextra",
                "-I${env:CUDA_PATH}/include",
                "-I${workspaceFolder}/include",
                "${file}",
                "-L${env:CUDA_PATH}/lib/x64",
                "-lOpenCL",
                "-fuse-ld=lld",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe build active file",
            "command": "D:/User/Software/Cpp_files/mingw-llvm/bin/clang++.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-I${env:CUDA_PATH}/include",
                "-I${workspaceFolder}/include",
                "${file}",
                "-L${env:CUDA_PATH}/lib/x64",
                "-lOpenCL",
                "-fuse-ld=lld",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "D:/User/Software/Cpp_files/mingw-llvm/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}