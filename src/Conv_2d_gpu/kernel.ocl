#pragma OPENCL EXTENSION cl_khr_fp16 : enable

inline int index3d(int z, int y, int x, int height, int width) {
    return z * (height) * (width) + y * (width) + x;
}
inline int index4d(int k, int z, int y, int x, int depth, int height, int width) {
    return k * (depth) * (height) * (width) + index3d(z, y, x, height, width);
}

__kernel void kernel_app_local(
    __global const unsigned char* input_img,
    __global float* output_img,
    __global const float* filter_k,
    const int stride,
    const int input_w,
    const int input_h,
    const int channels,
    const int filter_w,
    const int filter_h,
    const int filter_channels,
    const int output_w,
    const int output_h,
    const int tile_w,
    const int tile_h,
    __local unsigned char* input_tile,
    __local float* local_filter_k
)
{
    // Global and local IDs
    int lix = get_local_id(0);
    int liy = get_local_id(1);
    int gix = get_global_id(0);
    int giy = get_global_id(1);
    int ch = get_global_id(2);
    
    // __________________ load data to local memory __________________
    // Top-left global input coordinates for this work-group's tile
    int group_input_start_x = get_group_id(0) * get_local_size(0) * stride;
    int group_input_start_y = get_group_id(1) * get_local_size(1) * stride;
        
    // Load data into local memory tile (input_tile)
    for (int ty = liy; ty < tile_h; ty += get_local_size(1)) {
        for (int tx = lix; tx < tile_w; tx += get_local_size(0)) {
            int current_global_x = group_input_start_x + tx;
            int current_global_y = group_input_start_y + ty;
            int tile_idx = ty * tile_w + tx;
                
            if (current_global_x >= 0 && current_global_x < input_w &&
                current_global_y >= 0 && current_global_y < input_h) {
                int global_input_idx = (ch * input_h * input_w) + (current_global_y * input_w + current_global_x);
                input_tile[tile_idx] = input_img[global_input_idx];
            } else {
                input_tile[tile_idx] = 0;
            }
        }
    }
    
    // ________ load filter_k to local memory ________
    int local_flat_idx = liy * get_local_size(0) + lix;
    int local_wg_total_items = get_local_size(0) * get_local_size(1);

    if (local_flat_idx < filter_w * filter_h)
        local_filter_k[local_flat_idx] = filter_k[local_flat_idx];
    
    if (filter_w * filter_h < local_wg_total_items && 
            local_flat_idx+local_wg_total_items < filter_w * filter_h)
        local_filter_k[local_flat_idx+local_wg_total_items] = filter_k[local_flat_idx];
    
    if (filter_w * filter_h < 2 * local_wg_total_items && 
            local_flat_idx == local_wg_total_items)
        for (int i = 0; i < local_wg_total_items; i++)
            local_filter_k[2 * local_wg_total_items + i] = filter_k[local_flat_idx];


    barrier(CLK_LOCAL_MEM_FENCE); // Synchronize work-items in the group

    // __________________ conv cal __________________
    // Check if current global work-item is within output image bounds
    if (gix < output_w && giy < output_h && ch < channels) {
        for (int fc = 0; fc < filter_channels; fc++) {
            int local_conv_start_x = lix * stride;
            int local_conv_start_y = liy * stride;

            // Perform convolution using data from the local input_tile
            float sum = 0.0f;
            for (int fy = 0; fy < filter_h; fy++) {
                for (int fx = 0; fx < filter_w; fx++) {
                    int tile_access_x = local_conv_start_x + fx;
                    int tile_access_y = local_conv_start_y + fy;
                    
                    int current_tile_idx = tile_access_y * tile_w + tile_access_x;
                    int filter_idx = fy * filter_w + fx;
                    
                    float input_val = (float)input_tile[current_tile_idx] / 255.0f;
                    float filter_val = local_filter_k[filter_idx]; 
                    sum += input_val * filter_val;
                }
            }
            
            // Write the result to the output image
            int output_idx = (ch * output_h * output_w) + (giy * output_w + gix) 
                        + (fc * output_w * output_h);
            output_img[output_idx] = sum;
        }
    }
}

__kernel void kernel_app(
    __global const unsigned char* in, // (w h img_c)
    __global float* out, // (ow oh fc)
    __global const float* filt, // (fw fh img_c fc)
    const int stride,
    const int in_w,
    const int in_h,
    const int channel_count,
    const int filt_w,
    const int filt_h,
    const int filt_c,
    const int out_w,
    const int out_h
)
{
    int out_x = get_global_id(0);
    int out_y = get_global_id(1);

    for (int fc = 0; fc < filt_c; ++fc) {
        float sum = 0.0f;

        for (int in_c = 0; in_c < channel_count; ++in_c)
            for (int filt_y = 0; filt_y < filt_h; ++filt_y)
                for (int filt_x = 0; filt_x < filt_w; ++filt_x) {
                    int in_x = out_x * stride + filt_x;
                    int in_y = out_y * stride + filt_y;
                    sum += (float)in[index3d(in_c, in_y, in_x, in_h, in_w)] / 255.f *
                            filt[index4d(fc, in_c, filt_y, filt_x, channel_count, filt_h, filt_w)];
                }

        out[index3d(fc, out_y, out_x, out_h, out_w)] = sum;
    }
}
